  "voices": [
    {
      "id": "N01",
      "type": "narration",
      "shot": "S01",
      "start": 0.55,
      "end": 6.502,
      "text": "早上七点半，桌上有三盒药，一张写了又划掉的单子。",
      "wav": "tts/N01.wav",
      "duration_s": 5.952
    },
    {
      "id": "N02",
      "type": "narration",
      "shot": "S02",
      "start": 8.05,
      "end": 12.778,
      "text": "哪盒饭前，哪盒饭后，昨天到底吃没吃——",
      "wav": "tts/N02.wav",
      "duration_s": 4.728
    },
    {
      "id": "N03",
      "type": "narration",
      "shot": "S04",
      "start": 20.3,
      "end": 25.508,
      "text": "电话那头问一句『今天吃药了吗』，这头常常答不上来。",
      "wav": "tts/N03.wav",
      "duration_s": 5.208
    },
    {
      "id": "S04-D01",
      "type": "dialogue",
      "shot": "S04",
      "start": 25.888,
      "end": 28.552,
      "text": "妈，今天药吃了吗？",
      "wav": "tts/S04-D01.wav",
      "duration_s": 2.664
    },
    {
      "id": "S04-D02",
      "type": "dialogue",
      "shot": "S04",
      "start": 28.932,
      "end": 30.804,
      "text": "……吃了吧。",
      "wav": "tts/S04-D02.wav",
      "duration_s": 1.872
    },
    {
      "id": "N04",
      "type": "narration",
      "shot": "S05",
      "start": 32.3,
      "end": 38.828,
      "text": "不是不上心。是字太小，规矩太多，一天要记好几回。",
      "wav": "tts/N04.wav",
      "duration_s": 6.528
    },
    {
      "id": "N05",
      "type": "narration",
      "shot": "S06",
      "start": 40.3,
      "end": 45.292,
      "text": "在外的人，能做的也只剩再发一句『记得吃药』。",
      "wav": "tts/N05.wav",
      "duration_s": 4.992
    },
    {
      "id": "N06",
      "type": "narration",
      "shot": "S07",
      "start": 49.3,
      "end": 53.308,
      "text": "可这件事，本来不该靠谁替她记着。",
      "wav": "tts/N06.wav",
      "duration_s": 4.008
    },
    {
      "id": "N07",
      "type": "narration",
      "shot": "S08",
      "start": 58.3,
      "end": 62.164,
      "text": "她没打开什么 App，只是说了一句话。",
      "wav": "tts/N07.wav",
      "duration_s": 3.864
    },
    {
      "id": "S08-D01",
      "type": "dialogue",
      "shot": "S08",
      "start": 62.544,
      "end": 66.168,
      "text": "早饭后的那一次，帮我记上。",
      "wav": "tts/S08-D01.wav",
      "duration_s": 3.624
    },
    {
      "id": "S09-D01",
      "type": "dialogue",
      "shot": "S09",
      "start": 67.55,
      "end": 70.478,
      "text": "您听听对不对：早饭后那一次。",
      "wav": "tts/S09-D01.wav",
      "duration_s": 2.928
    },
    {
      "id": "N08",
      "type": "narration",
      "shot": "S10",
      "start": 74.55,
      "end": 78.198,
      "text": "药到。不用学，只要说。",
      "wav": "tts/N08.wav",
      "duration_s": 3.648
    },
    {
      "id": "N09",
      "type": "narration",
      "shot": "S11",
      "start": 82.55,
      "end": 87.374,
      "text": "这一段是设计示意，不是真机，也不是录屏。",
      "wav": "tts/N09.wav",
      "duration_s": 4.824
    },
    {
      "id": "N10",
      "type": "narration",
      "shot": "S12",
      "start": 89.55,
      "end": 95.19,
      "text": "按设计，它一次只说一件事，说完等你，不打断。",
      "wav": "tts/N10.wav",
      "duration_s": 5.64
    },
    {
      "id": "N11",
      "type": "narration",
      "shot": "S13",
      "start": 96.8,
      "end": 102.896,
      "text": "说定了，它把药名和时间复述一遍，问一句『您听听对不对』。",
      "wav": "tts/N11.wav",
      "duration_s": 6.096
    },
    {
      "id": "N12",
      "type": "narration",
      "shot": "S15",
      "start": 110.8,
      "end": 115.768,
      "text": "建档，只要一句话；它会复述，不替您猜。",
      "wav": "tts/N12.wav",
      "duration_s": 4.968
    },
    {
      "id": "S15-D01",
      "type": "dialogue",
      "shot": "S15",
      "start": 116.148,
      "end": 119.772,
      "text": "早饭后的那一次，帮我记上。",
      "wav": "tts/S15-D01.wav",
      "duration_s": 3.624
    },
    {
      "id": "N13",
      "type": "narration",
      "shot": "S16",
      "start": 121.3,
      "end": 125.212,
      "text": "问早上吃什么，它只念早饭那一段。",
      "wav": "tts/N13.wav",
      "duration_s": 3.912
    },
    {
      "id": "S16-D01",
      "type": "dialogue",
      "shot": "S16",
      "start": 125.592,
      "end": 127.896,
      "text": "早上该吃什么？",
      "wav": "tts/S16-D01.wav",
      "duration_s": 2.304
    },
    {
      "id": "S16-D02",
      "type": "dialogue",
      "shot": "S16",
      "start": 128.276,
      "end": 130.724,
      "text": "早饭这一段，就这些。",
      "wav": "tts/S16-D02.wav",
      "duration_s": 2.448
    },
    {
      "id": "N14",
      "type": "narration",
      "shot": "S17",
      "start": 132.3,
      "end": 136.98,
      "text": "一句『我吃过了』，就算记上；漏了也不责怪。",
      "wav": "tts/N14.wav",
      "duration_s": 4.68
    },
    {
      "id": "S17-D01",
      "type": "dialogue",
      "shot": "S17",
      "start": 137.36,
      "end": 139.232,
      "text": "我吃过了。",
      "wav": "tts/S17-D01.wav",
      "duration_s": 1.872
    },
    {
      "id": "N15",
      "type": "narration",
      "shot": "S18",
      "start": 140.8,
      "end": 147.112,
      "text": "问一句今天吃得怎么样，它算出还差几次，说得清清楚楚。",
      "wav": "tts/N15.wav",
      "duration_s": 6.312
    },
    {
      "id": "S18-D01",
      "type": "dialogue",
      "shot": "S18",
      "start": 147.492,
      "end": 150.348,
      "text": "我今天吃药情况怎样？",
      "wav": "tts/S18-D01.wav",
      "duration_s": 2.856
    },
    {
      "id": "N16",
      "type": "narration",
      "shot": "S19",
      "start": 151.8,
      "end": 156.72,
      "text": "正忙着？说一声『等会儿』，它就晚一点再来。",
