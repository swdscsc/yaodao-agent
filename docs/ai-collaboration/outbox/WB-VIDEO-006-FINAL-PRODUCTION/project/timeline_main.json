      "duration_s": 4.92
    },
    {
      "id": "S19-D01",
      "type": "dialogue",
      "shot": "S19",
      "start": 157.1,
      "end": 159.428,
      "text": "等会儿再提醒我。",
      "wav": "tts/S19-D01.wav",
      "duration_s": 2.328
    },
    {
      "id": "N17",
      "type": "narration",
      "shot": "S20",
      "start": 161.05,
      "end": 166.594,
      "text": "下次唤醒它，到点还没打卡的那一次，它会先提一句。",
      "wav": "tts/N17.wav",
      "duration_s": 5.544
    },
    {
      "id": "N18",
      "type": "narration",
      "shot": "S21",
      "start": 169.05,
      "end": 173.058,
      "text": "记不清名字，就把药盒举起来给它看。",
      "wav": "tts/N18.wav",
      "duration_s": 4.008
    },
    {
      "id": "S21-D01",
      "type": "dialogue",
      "shot": "S21",
      "start": 173.438,
      "end": 175.838,
      "text": "帮我拍个照记上。",
