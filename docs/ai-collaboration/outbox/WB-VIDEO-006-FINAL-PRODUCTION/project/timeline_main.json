      "duration_s": 2.4
    },
    {
      "id": "N19",
      "type": "narration",
      "shot": "S22",
      "start": 177.3,
      "end": 182.268,
      "text": "它念出认到的内容，认不清的，一次只问一件。",
      "wav": "tts/N19.wav",
      "duration_s": 4.968
    },
    {
      "id": "S22-D01",
      "type": "dialogue",
      "shot": "S22",
      "start": 182.648,
      "end": 185.336,
      "text": "是饭前吃还是饭后吃呀？",
