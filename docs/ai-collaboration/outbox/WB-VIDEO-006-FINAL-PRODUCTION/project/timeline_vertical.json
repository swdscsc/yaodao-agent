  "voices": [
    {
      "id": "V01",
      "type": "narration",
      "shot": "V01",
      "start": 0.16,
      "end": 4.12,
      "text": "早上七点半，三盒药，一张划了又改的单子。",
      "wav": "tts/V01.wav",
      "duration_s": 3.96
    },
    {
      "id": "V02",
      "type": "narration",
      "shot": "V02",
      "start": 4.66,
      "end": 8.428,
      "text": "电话里问『今天吃药了吗』，这头常常答不上来。",
      "wav": "tts/V02.wav",
      "duration_s": 3.768
    },
    {
      "id": "V02-D01",
      "type": "dialogue",
      "shot": "V02",
      "start": 8.548,
      "end": 11.212,
      "text": "妈，今天药吃了吗？",
      "wav": "tts/V02-D01.wav",
      "duration_s": 2.664
    },
    {
      "id": "V03",
      "type": "narration",
      "shot": "V03",
      "start": 11.66,
      "end": 14.636,
      "text": "药到。不用学，只要说。",
      "wav": "tts/V03.wav",
      "duration_s": 2.976
    },
    {
      "id": "V04",
      "type": "narration",
      "shot": "V04",
      "start": 15.16,
      "end": 19.0,
      "text": "下面是设计示意，不是真机，也不是录屏。",
      "wav": "tts/V04.wav",
      "duration_s": 3.84
    },
    {
      "id": "V05",
      "type": "narration",
      "shot": "V05",
      "start": 19.41,
      "end": 22.938,
      "text": "说一句话建档，它会复述，不替您猜。",
      "wav": "tts/V05.wav",
      "duration_s": 3.528
    },
    {
      "id": "V06",
      "type": "narration",
      "shot": "V06",
      "start": 23.66,
      "end": 26.852,
      "text": "问早上吃什么，它只念早饭那一段。",
      "wav": "tts/V06.wav",
      "duration_s": 3.192
    },
    {
      "id": "V07",
      "type": "narration",
      "shot": "V07",
      "start": 27.66,
      "end": 30.228,
      "text": "一句『我吃过了』，就算记上。",
      "wav": "tts/V07.wav",
      "duration_s": 2.568
    },
    {
      "id": "V07-D01",
      "type": "dialogue",
      "shot": "V07",
      "start": 30.348,
      "end": 32.22,
      "text": "我吃过了。",
      "wav": "tts/V07-D01.wav",
      "duration_s": 1.872
    },
    {
      "id": "V08",
      "type": "narration",
      "shot": "V08",
      "start": 32.66,
      "end": 35.252,
      "text": "认不清的，一次只问一件。",
      "wav": "tts/V08.wav",
      "duration_s": 2.592
    },
    {
      "id": "V09",
      "type": "narration",
      "shot": "V09",
      "start": 36.66,
      "end": 39.852,
      "text": "有些问题，它不接，让您问大夫。",
      "wav": "tts/V09.wav",
      "duration_s": 3.192
    },
    {
      "id": "V10",
      "type": "narration",
      "shot": "V10",
      "start": 40.91,
      "end": 45.446,
      "text": "不推荐药，不改剂量；紧急情况，先拨 120。",
      "wav": "tts/V10.wav",
      "duration_s": 4.536
    },
    {
      "id": "V11",
      "type": "narration",
      "shot": "V11",
      "start": 45.91,
      "end": 49.486,
      "text": "今天，给爸妈打个电话：今天吃药了吗。",
      "wav": "tts/V11.wav",
      "duration_s": 3.576
    }
  ],
